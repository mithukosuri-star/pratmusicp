{
  "name": "PratMusic — Offline Music",
  "short_name": "PratMusic",
  "description": "A beautiful offline music player. Bundled open-licensed music, your own uploads, live visualizer, zero network required.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
